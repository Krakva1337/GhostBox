#!/bin/sh
set -eu

HERE="$(dirname "$(readlink -f "$0")")"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
VENDOR_DIR="$DATA_HOME/ghostbox-appimage/vendor"

# Auto-updates replace the extracted AppDir, but older installed updater
# scripts may not refresh desktop metadata. Repair the launcher on every start
# of an installed release so Rofi never keeps a versioned/stale application
# name after updating.
case "$HERE/" in
  "$HOME/.local/opt/ghostbox/releases/"*)
    DESKTOP_DIR="$DATA_HOME/applications"
    LAUNCHER="$HOME/.local/bin/ghostbox"
    mkdir -p "$DESKTOP_DIR"
    cat > "$DESKTOP_DIR/ghostbox.desktop" <<EOF
[Desktop Entry]
Name=GhostBox Alpha
Comment=Linux VPN client powered by Xray and sing-box
Exec="$LAUNCHER" %U
TryExec=$LAUNCHER
Icon=ghostbox
Terminal=false
Type=Application
Categories=Network;Security;
MimeType=x-scheme-handler/ghostbox;
StartupWMClass=ghostbox
EOF
    chmod 0644 "$DESKTOP_DIR/ghostbox.desktop"
    if command -v update-desktop-database >/dev/null 2>&1; then
      update-desktop-database "$DESKTOP_DIR" >/dev/null 2>&1 || true
    fi
    ;;
esac

# AppImages are mounted read-only. Keep the active core in a user-owned
# directory so CAP_NET_ADMIN can be granted to either core with setcap.
mkdir -p "$VENDOR_DIR/bin"
for core in sing-box xray; do
  source="$HERE/vendor/bin/$core"
  target="$VENDOR_DIR/bin/$core"
  if [ ! -x "$target" ] || ! cmp -s "$source" "$target"; then
    install -m 0755 "$source" "$target"
  fi
done
if [ -f "$HERE/vendor/bin/BUILD-INFO.txt" ]; then
	if [ ! -f "$VENDOR_DIR/bin/BUILD-INFO.txt" ] || ! cmp -s "$HERE/vendor/bin/BUILD-INFO.txt" "$VENDOR_DIR/bin/BUILD-INFO.txt"; then
		install -m 0644 "$HERE/vendor/bin/BUILD-INFO.txt" "$VENDOR_DIR/bin/BUILD-INFO.txt"
	fi
fi
if [ -f "$HERE/vendor/bin/ghostbox-hotspot-vpn.sh" ]; then
	if [ ! -x "$VENDOR_DIR/bin/ghostbox-hotspot-vpn.sh" ] || ! cmp -s "$HERE/vendor/bin/ghostbox-hotspot-vpn.sh" "$VENDOR_DIR/bin/ghostbox-hotspot-vpn.sh"; then
		install -m 0755 "$HERE/vendor/bin/ghostbox-hotspot-vpn.sh" "$VENDOR_DIR/bin/ghostbox-hotspot-vpn.sh"
	fi
fi

export GHOSTBOX_VENDOR_DIR="$VENDOR_DIR"
export GHOSTBOX_ICON_PATH="$HERE/ghostbox.png"
export LD_LIBRARY_PATH="$HERE/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
APP_BINARY="$HERE/GhostBox"
if [ ! -x "$APP_BINARY" ]; then
  APP_BINARY="$HERE/ghostbox"
fi
exec "$APP_BINARY" "$@"
